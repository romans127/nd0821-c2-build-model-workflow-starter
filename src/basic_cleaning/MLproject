name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Name of the input artifact (raw data) in W&B
        type: string

      output_artifact:
        description: Name for the output artifact (cleaned data)
        type: string

      output_type:
        description: Type of the output artifact
        type: string

      output_description:
        description: A brief description of the output artifact
        type: string

      min_price:
        description: Minimum accepted price; listings below this are dropped
        type: float

      max_price:
        description: Maximum accepted price; listings above this are dropped
        type: float

    command: "python run.py --input_artifact {input_artifact} --output_artifact {output_artifact} --output_type {output_type} --output_description {output_description} --min_price {min_price} --max_price {max_price}"
